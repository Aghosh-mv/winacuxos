#!/usr/bin/env bash
# wcx - the WinacuxOS command line.
#
#   wcx flow <name>          Winacux Flow: open an intent workspace
#   wcx flows                list available flows
#   wcx ask <question>       ask the local Winacux AI
#   wcx doctor               diagnose the system (Safe Mode)
#   wcx snapshot create|restore|list|delete
#   wcx remove <package>     remove an app and every leftover file
#   wcx vault create|open|close
#   wcx dupes <dir>          find duplicate files
#   wcx cursors list|import|apply   cursor themes (Cursor Studio)
#   wcx help
set -uo pipefail

# Privileged actions (snapshots, updates, package removal) must work when the
# command comes from the desktop, not a terminal, so they elevate through
# pkexec and get a normal graphical password prompt.
WINACUX_PRIVILEGED="snapshot remove update vault dupes rescue"
is_privileged() {
    for candidate in $WINACUX_PRIVILEGED; do
        [ "$1" = "$candidate" ] && return 0
    done
    return 1
}
if [ "$(id -u)" -ne 0 ] && [ "${1:-}" != "--elevated" ] && is_privileged "${1:-}"; then
    exec pkexec "$0" --elevated "$@"
fi
[ "${1:-}" = "--elevated" ] && shift

WINACUX_HOME="${WINACUX_HOME:-$HOME/.config/winacux}"
FLOW_DIR="$WINACUX_HOME/flows"
ACTIVE_FILE="$WINACUX_HOME/active-flow"
AI_HOST="${WINACUX_AI_HOST:-127.0.0.1}"
AI_PORT="${WINACUX_AI_PORT:-8080}"
AI_MODEL="${WINACUX_AI_MODEL:-winacux-local}"
VAULT_DIR="${WINACUX_VAULT:-$HOME/Vault}"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '\033[36m::\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!!\033[0m %s\n' "$*"; }
fail() { printf '\033[31mxx\033[0m %s\n' "$*" >&2; }

cmd_flow() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        fail "usage: wcx flow <name>   (see: wcx flows)"
        return 1
    fi
    if [ ! -f "$FLOW_DIR/$name.json" ]; then
        fail "no flow named '$name'"
        wcx_help_flows
        return 1
    fi
    mkdir -p "$WINACUX_HOME"
    printf '%s' "$name" > "$ACTIVE_FILE"
    info "Flow '$name' triggered"
}

cmd_flows() {
    if [ ! -d "$FLOW_DIR" ]; then
        fail "no flows directory at $FLOW_DIR"
        return 1
    fi
    for f in "$FLOW_DIR"/*.json; do
        [ -e "$f" ] || continue
        name="$(basename "$f" .json)"
        apps="$(sed -n 's/.*"apps"[^]]*]//p' "$f" | tr -d '[]"' | tr ',' '\n' | wc -l | tr -d ' ')"
        ws="$(sed -n 's/.*"workspace"[^0-9]*\([0-9]\+\).*/\1/p' "$f")"
        bold "$name"
        printf '    workspace %s, %s apps\n' "${ws:-0}" "${apps:-0}"
    done
}

wcx_help_flows() {
    printf '    available: '
    (cd "$FLOW_DIR" 2>/dev/null && ls -1 *.json 2>/dev/null | sed 's/\.json//' | tr '\n' ' ')
    printf '\n'
}

cmd_ask() {
    local question="$*"
    if [ -z "$question" ]; then
        fail "usage: wcx ask <question>"
        return 1
    fi
    if ! command -v curl >/dev/null; then
        fail "curl not found"
        return 1
    fi
    local payload
    payload=$(python3 - "$question" "$AI_MODEL" <<'PY'
import json, sys
print(json.dumps({
    "model": sys.argv[2],
    "messages": [{"role": "user", "content": sys.argv[1]}],
    "stream": False,
}))
PY
) || { fail "could not build request"; return 1; }

    local response
    response=$(curl -s --max-time 120 \
        -H 'Content-Type: application/json' \
        -d "$payload" \
        "http://$AI_HOST:$AI_PORT/v1/chat/completions")

    if [ -z "$response" ]; then
        fail "Winacux AI is not answering on $AI_HOST:$AI_PORT"
        info "start it with: sudo systemctl start winacux-ai"
        return 1
    fi

    printf '%s' "$response" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("could not parse AI response")
    raise SystemExit(1)
for choice in data.get("choices", []):
    print(choice.get("message", {}).get("content", "").strip())
'
}

cmd_doctor() {
    local problems=0
    bold "WinacuxOS diagnostics"
    printf '    %s\n' "$(date)"

    info "disk space"
    df -h / | tail -1

    info "memory"
    free -h

    info "failed services"
    if systemctl --failed --no-legend --plain 2>/dev/null | grep -q .; then
        systemctl --failed --no-legend --plain
        problems=$((problems + 1))
    else
        echo "    none"
    fi

    info "recent critical kernel messages"
    journalctl -p err -b --no-pager 2>/dev/null | tail -15 || echo "    (unavailable)"

    info "package database"
    if dpkg --audit 2>/dev/null | grep -q .; then
        dpkg --audit
        problems=$((problems + 1))
    else
        echo "    clean"
    fi

    info "pending updates"
    apt list --upgradable 2>/dev/null | tail -n +2 | head -10

    info "snapshots"
    timeshift --list 2>/dev/null | tail -5 || echo "    (timeshift not installed)"

    if [ "$problems" -eq 0 ]; then
        printf '\n\033[32mOK\033[0m no blocking problems found\n'
    else
        printf '\n\033[33m!\033[0m %s problem group(s) found - try: wcx snapshot create\n' "$problems"
    fi
    return 0
}

cmd_snapshot() {
    local action="${1:-list}"
    case "$action" in
        create)   timeshift --create --comments "WinacuxOS manual snapshot" ;;
        restore)  timeshift --restore ;;
        list)     timeshift --list ;;
        delete)   timeshift --delete "$2" ;;
        *) fail "usage: wcx snapshot create|restore|list|delete <n>"; return 1 ;;
    esac
}

cmd_remove() {
    local pkg="$1"
    if [ -z "$pkg" ]; then
        fail "usage: wcx remove <package>"
        return 1
    fi
    info "purging $pkg and its dependencies"
    sudo apt-get purge -y "$pkg"
    info "removing orphaned packages and caches"
    sudo apt-get autoremove --purge -y
    sudo apt-get clean
    info "done - $pkg and its leftovers are gone"
}

cmd_vault() {
    local action="${1:-}"
    case "$action" in
        create)
            mkdir -p "$VAULT_DIR"
            gocryptfs -t "$VAULT_DIR.xfs" "$VAULT_DIR"
            echo "$VAULT_DIR" > "$WINACUX_HOME/vault-path"
            ;;
        open)
            [ -f "$VAULT_DIR.xfs" ] || { fail "no vault found at $VAULT_DIR.xfs"; return 1; }
            gocryptfs "$VAULT_DIR.xfs" "$VAULT_DIR"
            ;;
        close)
            fusermount -u "$VAULT_DIR" 2>/dev/null || fail "vault not mounted"
            ;;
        *) fail "usage: wcx vault create|open|close"; return 1 ;;
    esac
}

cmd_dupes() {
    local dir="${1:-$HOME}"
    [ -d "$dir" ] || { fail "no such directory: $dir"; return 1; }
    fdupes -r "$dir" | tee "$WINACUX_HOME/duplicates.txt"
    info "report saved to $WINACUX_HOME/duplicates.txt"
}

cmd_cursors() {
    case "${1:-list}" in
        list)   exec /usr/local/bin/wcx-cursors list ;;
        import) shift; exec /usr/local/bin/wcx-cursors import "$@" ;;
        apply)  shift; exec /usr/local/bin/wcx-cursors apply "$@" ;;
        *) fail "usage: wcx cursors list|import <file>|apply <theme>"; return 1 ;;
    esac
}

cmd_find() {
    local terms="$*"
    if [ -z "$terms" ]; then
        fail "usage: wcx find <words>"
        return 1
    fi
    # Local search only: fd (fast) with a locate fallback for machines where the
    # index has not been built yet.
    local results
    if command -v fdfind >/dev/null 2>&1; then
        results=$(fdfind --type f --hidden --follow --exclude .git \
                      --ignore-case "$terms" "$HOME" 2>/dev/null | head -40)
    elif command -v fd >/dev/null 2>&1; then
        results=$(fd --type f --hidden --follow --exclude .git --ignore-case \
                     "$terms" "$HOME" 2>/dev/null | head -40)
    else
        results=$(find "$HOME" -type f -iname "*${terms}*" 2>/dev/null | head -40)
    fi

    if [ -z "$results" ]; then
        warn "nothing matched \"$terms\""
        return 1
    fi

    info "found $(printf '%s\n' "$results" | wc -l | tr -d ' ') files"
    printf '%s\n' "$results" | while read -r file; do
        printf '    %s\n' "$file"
    done

    # Hand the results to Files so the user can act on them.
    local dir
    dir=$(dirname "$(printf '%s\n' "$results" | head -1)")
    if command -v nautilus >/dev/null 2>&1; then
        nautilus --select "$(printf '%s\n' "$results" | head -1)" >/dev/null 2>&1 &
    elif [ -n "$dir" ]; then
        xdg-open "$dir" >/dev/null 2>&1 &
    fi
}

# ------------------------------------------------------- AI everywhere

cmd_explain() {
    local text="$*"
    if [ -z "$text" ]; then
        # No argument: explain whatever is on the clipboard.
        if command -v wl-paste >/dev/null 2>&1; then
            text=$(wl-paste --no-newline 2>/dev/null)
        fi
    fi
    if [ -z "$text" ]; then
        fail "nothing to explain - pass some text or copy it first"
        return 1
    fi
    info "asking the local model"
    cmd_ask "Explain this in two sentences, and say what I should do about it:\n\n$text"
}

cmd_shot() {
    local out="${TMPDIR:-/tmp}/winacux-screen.png"
    info "capturing the screen"

    # GNOME exposes its screenshot API on the session bus.
    if ! gdbus call --session --dest org.gnome.Shell.Screenshot \
            --object-path /org/gnome/Shell/Screenshot \
            --method org.gnome.Shell.Screenshot.Screenshot false false "$out" >/dev/null 2>&1; then
        fail "screen capture failed (is a GNOME session running?)"
        return 1
    fi

    if ! command -v tesseract >/dev/null 2>&1; then
        info "saved to $out (install tesseract-ocr to read text from it)"
        return 0
    fi

    local text
    text=$(tesseract "$out" stdout 2>/dev/null)
    if [ -z "${text//[[:space:]]/}" ]; then
        info "no text found on screen; image saved to $out"
        return 0
    fi

    info "read from screen:"
    printf '%s\n' "$text" | head -12 | sed 's/^/    /'
    printf '\n'
    cmd_ask "This is the text from a screenshot on my screen. What does it mean, and what should I do?\n\n$text"
}

cmd_desk() {
    local action="${1:-save}"
    local file="$WINACUX_HOME/layouts.json"
    case "$action" in
        save)
            mkdir -p "$WINACUX_HOME"
            if command -v wmctrl >/dev/null 2>&1; then
                wmctrl -l > "$file.windows" 2>/dev/null || true
            fi
            gdbus call --session --dest org.gnome.Shell \
                --object-path /org/gnome/Shell \
                --method org.gnome.Shell.Eval \
                "global.get_window_actors().map(a => a.meta_window.get_application()?.get_id()).filter(Boolean)" \
                > "$file" 2>/dev/null || \
                printf '%s\n' '{"note":"open Winacux Command and type \"start study\" to rebuild the desk"}' > "$file"
            info "desk saved to $file"
            ;;
        show)
            [ -f "$file" ] && cat "$file" || warn "no saved layout yet - try: wcx desk save"
            ;;
        *)
            fail "usage: wcx desk save|show"
            return 1
            ;;
    esac
}

cmd_theme() {
    exec /usr/local/bin/winacux-theme
}

cmd_update() {
    local action="${1:-check}"
    case "$action" in
        check)
            info "refreshing package lists"
            apt-get update -qq
            local pending
            pending=$(apt list --upgradable 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')
            if [ "$pending" -eq 0 ]; then
                printf '\033[32mOK\033[0m WinacuxOS is up to date\n'
            else
                printf '\033[33m!\033[0m %s package(s) can be updated\n' "$pending"
                apt list --upgradable 2>/dev/null | tail -n +8 | head -20
            fi
            ;;
        apply)
            # Snapshot first: Winacux Snapshot guards every update.
            if [ -f /etc/timeshift/timeshift.json ]; then
                info "creating a pre-update snapshot"
                timeshift --create --comments "before WinacuxOS update" >/dev/null 2>&1 || \
                    warn "snapshot failed - continuing anyway"
            fi
            info "applying updates"
            DEBIAN_FRONTEND=noninteractive apt-get -y \
                -o Dpkg::Options::=--force-confdef \
                -o Dpkg::Options::=--force-confold \
                dist-upgrade
            info "reboot to finish (reboot is safe: a rollback snapshot exists)"
            ;;
        rollback)
            shift 2>/dev/null || true
            info "restoring the newest snapshot"
            timeshift --restore
            ;;
        *)
            fail "usage: wcx update check|apply|rollback"
            return 1
            ;;
    esac
}

cmd_help() {
    cat <<'EOF'
WinacuxOS - wcx

  wcx flow <name>            open a Winacux Flow workspace
  wcx flows                  list your flows
  wcx ask <question>         ask the offline Winacux AI
  wcx doctor                 diagnose this system (Safe Mode)
  wcx snapshot create        snapshot the system now
  wcx snapshot restore       restore a snapshot
  wcx snapshot list          list snapshots
  wcx remove <package>       uninstall an app and all leftovers
  wcx vault create|open|close  encrypted personal vault
  wcx dupes <dir>            find duplicate files
  wcx cursors list           list cursor themes
  wcx cursors import <file>  import a .zip/.ani/.cur cursor pack
  wcx mouse                  open the Mouse settings window
  wcx theme                  open Theme Studio (accent, Light/Dark/Neon)
  wcx find <words>           local file search, opens Files on the best match
  wcx explain [text]         ask the AI to explain text (or the clipboard)
  wcx shot                   screenshot -> OCR -> ask the AI what is wrong
  wcx rescue                 open Winacux Rescue
  wcx desk save|show         remember this workspace layout
  wcx update check|apply|rollback   snapshot-first updates
EOF
}

case "${1:-help}" in
    flow)     shift; cmd_flow "$@" ;;
    flows)    cmd_flows ;;
    ask)      shift; cmd_ask "$@" ;;
    doctor)   cmd_doctor ;;
    snapshot) shift; cmd_snapshot "$@" ;;
    remove)   shift; cmd_remove "$@" ;;
    vault)    shift; cmd_vault "$@" ;;
    dupes)    shift; cmd_dupes "$@" ;;
    cursors)  shift; cmd_cursors "$@" ;;
    find)     shift; cmd_find "$@" ;;
    explain)  shift; cmd_explain "$@" ;;
    shot)     cmd_shot ;;
    rescue)   exec /usr/local/bin/winacux-rescue ;;
    desk)     shift; cmd_desk "$@" ;;
    theme)    cmd_theme ;;
    update)   shift; cmd_update "$@" ;;
    mouse)    exec /usr/local/bin/winacux-mouse ;;
    help|-h|--help) cmd_help ;;
    *) fail "unknown command: $1"; cmd_help; exit 1 ;;
esac