#!/usr/bin/env python3
"""Winacux Theme Studio.

One accent colour, and the whole desktop follows: shell, dock, widget cards,
workspace pills, the command palette, the cursor trail and the window composer.
Light, Dark and Neon are first-class modes, not afterthoughts.

The app writes a small override stylesheet; the WinacuxOS shell extension layers
it on top of its base stylesheet and reloads it the moment the file changes - so
changing the colour here repaints the desktop immediately.
"""

import os
import pathlib
import subprocess
import sys

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gdk, Gtk

APP_ID = "org.winacuxos.Theme"
THEME_DIR = pathlib.Path.home() / ".config/winacux"
THEME_FILE = THEME_DIR / "theme.css"

PRESETS = [
    ("Winacux Violet", "#7b5cff"),
    ("Energy Blue", "#4da3ff"),
    ("Gojo Cyan", "#56d8ff"),
    ("Neon Magenta", "#ff5c8a"),
    ("Toxic Lime", "#7dd44f"),
    ("Ember", "#ff8a3d"),
]

MODES = {
    "Dark": """
.winacux-card,
.winacux-command,
.winacux-composer {
    background-color: rgba(11, 18, 32, 0.74);
    color: #f5f7fa;
}
""",
    "Light": """
.winacux-card,
.winacux-command,
.winacux-composer {
    background-color: rgba(246, 248, 252, 0.86);
    color: #16203a;
}
.winacux-command-title,
.winacux-row-key,
.winacux-card-title { color: #16203a; }
.winacux-command-detail { color: #55627a; }
""",
    "Neon": """
.winacux-card,
.winacux-command,
.winacux-composer {
    background-color: rgba(10, 6, 28, 0.80);
    border-color: ACCENT;
    box-shadow: 0 0 24px ACCENT_GLOW, 0 12px 40px rgba(0, 0, 0, 0.6);
}
.winacux-pill-active {
    background-image: linear-gradient(180deg, ACCENT, ACCENT_2);
    box-shadow: 0 0 12px ACCENT_GLOW;
}
.winacux-cursor-node {
    background-color: ACCENT_GLOW;
    box-shadow: 0 0 16px ACCENT_GLOW;
}
""",
}


def hex_to_rgb(value):
    value = value.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def shade(hex_color, factor):
    """Lighten (factor > 1) or darken a hex colour."""
    r, g, b = hex_to_rgb(hex_color)
    if factor >= 1:
        r, g, b = (min(255, int(c + (255 - c) * (factor - 1))) for c in (r, g, b))
    else:
        r, g, b = (max(0, int(c * factor)) for c in (r, g, b))
    return "#%02x%02x%02x" % (r, g, b)


def build_css(accent, mode):
    accent_2 = shade(accent, 1.35)
    glow = hex_to_rgb(accent)
    rgba = lambda a: f"rgba({glow[0]}, {glow[1]}, {glow[2]}, {a})"

    body = MODES.get(mode, MODES["Dark"])
    body = body.replace("ACCENT_GLOW", rgba(0.55))
    body = body.replace("ACCENT_2", accent_2)
    body = body.replace("ACCENT", accent)

    return f"""/* Generated by Winacux Theme Studio - accent {accent}, mode {mode}.
   Edit freely: the extension reloads this file the moment you save it. */

{body}

/* accent-driven pieces */
.winacux-pill-active {{
    background-image: linear-gradient(180deg, {accent}, {accent_2});
    color: #ffffff;
}}

.winacux-flow-button {{
    background-color: {rgba(0.16)};
    border-color: {rgba(0.38)};
    color: {shade(accent, 1.6)};
}}

.winacux-command-row-active {{
    background-color: {rgba(0.30)};
    border-left: 3px solid {accent};
}}

.winacux-composer-card-active {{
    background-color: {rgba(0.24)};
    border-color: {rgba(0.80)};
}}

.winacux-cursor-node {{
    background-color: {rgba(0.35)};
    box-shadow: 0 0 12px {rgba(0.55)};
}}

.winacux-logo-bin {{ border-radius: 14px; }}
"""


def apply_to_gtk(accent, mode):
    """Also theme GTK/libadwaita apps where the running GNOME allows it."""
    settings = Gio.Settings.new("org.gnome.desktop.interface")
    settings.set_string("gtk-theme", "Adwaita" if mode == "Light" else "Adwaita-dark")
    settings.set_boolean("gtk-application-prefer-dark-theme", mode != "Light")


class ThemeStudio(Adw.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application,
                         title="Winacux Theme Studio",
                         default_width=520, default_height=560)
        self._accent = "#7b5cff"
        self._mode = "Dark"

        header = Adw.HeaderBar()
        self.set_content(header)
        header.set_title_widget(Adw.WindowTitle.new("Theme Studio", "One accent, whole desktop"))

        page = Adw.PreferencesPage()
        self.add_child(page)

        # ---------------------------------------------------- accent picker
        group = Adw.PreferencesGroup(
            title="Accent",
            description="Repaints the shell, dock, widgets, palette, trail and composer.")
        page.add_group(group)

        picker_row = Adw.ActionRow(title="Accent colour")
        picker = Gtk.ColorDialogButton(
            dialog=Gtk.ColorDialog.new(),
            rgba=Gdk.RGBA(),
        )
        picker.set_dialog_title("Winacux accent")
        picker.connect("notify::rgba", lambda *_: self._on_color())
        picker_row.add_suffix(picker)
        picker_row.set_activatable_widget(picker)
        group.add(picker_row)
        self._picker = picker

        presets = Adw.PreferencesGroup(title="Presets")
        page.add_group(presets)
        for name, color in PRESETS:
            row = Adw.ActionRow(title=name, subtitle=color)
            button = Gtk.Button(label="Apply", valign=Gtk.Align.CENTER)
            button.connect("clicked", lambda _b, c=color: self._set_color(c))
            row.add_suffix(button)
            row.set_activatable_widget(button)
            presets.add(row)

        # ------------------------------------------------------------- modes
        modes = Adw.PreferencesGroup(title="Mode")
        page.add_group(modes)
        for mode in MODES:
            row = Adw.ActionRow(title=mode)
            radio = Gtk.CheckButton(group=None)
            radio.connect("toggled", lambda b, m=mode: b.set_active() and self._set_mode(m))
            if mode == self._mode:
                radio.set_active(True)
            row.add_prefix(radio)
            modes.add(row)

        # ----------------------------------------------------------- actions
        actions = Adw.PreferencesGroup(title="Apply")
        page.add_group(actions)
        save = Adw.ActionRow(title="Write theme", subtitle=THEME_FILE)
        button = Gtk.Button(label="Write", valign=Gtk.Align.CENTER)
        button.connect("clicked", lambda *_: self._write())
        save.add_suffix(button)
        save.set_activatable_widget(button)
        actions.add(save)

        apply_all = Adw.ActionRow(title="Write and apply everywhere",
                                  subtitle="Includes the GNOME accent colour")
        button2 = Gtk.Button(label="Apply all", valign=Gtk.Align.CENTER)
        button2.connect("clicked", lambda *_: self._write(apply_system=True))
        apply_all.add_suffix(button2)
        apply_all.set_activatable_widget(button2)
        actions.add(apply_all)

    # ---------------------------------------------------------------- helpers

    def _set_color(self, hex_color):
        self._accent = hex_color
        rgba = Gdk.RGBA()
        rgba.parse(hex_color)
        self._picker.set_rgba(rgba)
        self._write()

    def _on_color(self):
        rgba = self._picker.get_rgba()
        hex_color = "#%02x%02x%02x" % (
            int(rgba.red * 255), int(rgba.green * 255), int(rgba.blue * 255))
        self._accent = hex_color
        self._write()

    def _set_mode(self, mode):
        self._mode = mode
        self._write(apply_system=True)

    def _write(self, apply_system=False):
        THEME_DIR.mkdir(parents=True, exist_ok=True)
        THEME_FILE.write_text(build_css(self._accent, self._mode))
        if apply_system:
            settings = Gio.Settings.new("org.gnome.desktop.interface")
            settings.set_string("color-scheme", "prefer-dark" if self._mode != "Light"
                                else "prefer-light")
            try:
                subprocess.run(["gsettings", "set", "org.gnome.desktop.interface",
                                "accent-color", _named_accent(self._accent)], check=False)
            except Exception:
                pass
        self._toast(f"Theme written: {self._accent} · {self._mode}")

    def _toast(self, message):
        self.add_toast(Adw.Toast.new(message))


def _named_accent(hex_color):
    r, g, b = hex_to_rgb(hex_color)
    if b > r and b > g:
        return "blue"
    if r > b and r > g:
        return "orange"
    if g > r:
        return "green"
    return "purple"


class ThemeApplication(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        ThemeStudio(self).present()


def main():
    ThemeApplication().run([])
    return 0


if __name__ == "__main__":
    sys.exit(main())