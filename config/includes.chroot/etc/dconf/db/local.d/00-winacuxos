# System-wide WinacuxOS desktop defaults.
# Applied to every new user profile via the dconf system database.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/winacuxos/winacuxos.png'
picture-uri-dark='file:///usr/share/backgrounds/winacuxos/winacuxos.png'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='blue'
font-name='Inter 11'
icon-theme='Papirus'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/winacuxos/winacuxos.png'
lock-enabled=true
lock-delay=300

[org/gnome/login-screen]
logo='/usr/share/winacuxos/logo-gdm.png'
disable-user-availability=true

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop','org.gnome.Firefox.desktop','org.gnome.Terminal.desktop','org.gnome.Software.desktop']
enabled-extensions=['winacux@winacuxos.org','dash-to-dock@micxgx.gmail.com','ding@rastersoft.com','appindicatorsupport@rgcjonas.gmail.com','blur-my-shell@aunetx','user-theme@gnome-shell-extensions.gcampax.github.com']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='LEFT'
extend-height=true
show-show-apps-button=true
show-trash=true
show-mounts=false
panel-mode=false
transparency-mode='FIXED'

[org/gnome/shell/extensions/user-theme]
name='Winacux'

[org/gnome/mutter]
dynamic-workspaces=false

[org/gnome/desktop/wm/preferences]
num-workspaces=4

[org/gnome/shell/extensions/tiling-assistant]
tiling-enabled=false

# Workspace switching with the number row (mockup: switch with 1 2 3 4).
# Ctrl+Alt keeps plain typing keys usable inside text fields.
[org/gnome/desktop/wm/keybindings]
switch-to-workspace-1=['<Ctrl><Alt>1']
switch-to-workspace-2=['<Ctrl><Alt>2']
switch-to-workspace-3=['<Ctrl><Alt>3']
switch-to-workspace-4=['<Ctrl><Alt>4']
move-to-workspace-1=['<Ctrl><Alt><Shift>1']
move-to-workspace-2=['<Ctrl><Alt><Shift>2']
move-to-workspace-3=['<Ctrl><Alt><Shift>3']
move-to-workspace-4=['<Ctrl><Alt><Shift>4']