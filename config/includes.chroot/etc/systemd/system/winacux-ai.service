[Unit]
Description=Winacux AI - offline assistant backend (llama.cpp)
Documentation=man:wcx(8)
After=network.target

[Service]
Type=simple
Environment=WINACUX_AI_HOST=127.0.0.1
Environment=WINACUX_AI_PORT=8080
ExecStartPre=-/usr/bin/test -f /opt/winacux/ai/models/winacux-coder-q4_k_m.gguf
ExecStart=/usr/local/bin/llama-server \
    --model /opt/winacux/ai/models/winacux-coder-q4_k_m.gguf \
    --alias winacux-local \
    --host 127.0.0.1 \
    --port 8080 \
    --ctx-size 4096 \
    --threads 4
Restart=on-failure
RestartSec=5
# The model is a fixed file served over loopback; keep it that way.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/winacux/ai

[Install]
WantedBy=graphical.target