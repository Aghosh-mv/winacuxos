#!/bin/sh
# WinacuxOS boot performance.
#
# A desktop that reaches the screen in seconds is a feature, so the image is
# trimmed on purpose: services the live session never needs are disabled and
# the initramfs is rebuilt with zstd. Nothing here removes functionality the
# user can reach - it only removes work nobody waits for.
set -e

LOG=/var/log/winacuxos-build.log
echo "[winacuxos] trimming boot time" | tee -a "$LOG"

# Services that only make sense on a persistent, installed machine.
for unit in \
    snapd.service snapd.socket snapd.seeded.service \
    cups.service cups-browsed.service \
    fwupd.service \
    geoclue.service \
    e2scrub_all.timer \
    man-db.timer \
    apt-daily.timer apt-daily-upgrade.timer \
    packagekit-offline-update.timer \
    systemd-networkd-wait-online.service \
    bluetooth.service \
    avahi-daemon.service avahi-daemon.socket
do
    if systemctl list-unit-files 2>/dev/null | grep -q "^${unit%%.*}"; then
        systemctl --quiet disable "$unit" >/dev/null 2>&1 || true
    fi
done

# packagekit stays: GNOME Software (the Winacux Store) needs it for updates.

# A smaller initramfs, decompressed faster.
if [ -f /etc/initramfs-tools/initramfs.conf ]; then
    sed -i 's/^COMPRESS=.*/COMPRESS=zstd/' /etc/initramfs-tools/initramfs.conf
fi
# NOTE: do not set MODULES here. Inside a live-build chroot the root device
# cannot be resolved, and MODULES=dep makes mkinitramfs fail with
# "failed to determine device for /". The default (most) works because it does
# not need to resolve it.
update-initramfs -u -k all >/dev/null 2>&1 || \
    echo "[winacuxos] note: initramfs refresh skipped (already current?)" | tee -a "$LOG"

# The live image diet. Documentation, manual pages and unused locales cost over
# a gigabyte and nobody on a live desktop reads them offline.
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* 2>/dev/null || true
rm -rf /usr/share/help/* 2>/dev/null || true
# Compiled locales under /usr/lib are the bulk of them, not /usr/share.
rm -rf /usr/lib/locale/* 2>/dev/null || true
mkdir -p /usr/lib/locale/en/LC_MESSAGES
# Sample sounds: keep the ALSA set, drop the demo library.
find /usr/share/sounds -mindepth 1 -maxdepth 1 ! -name alsa ! -name freedesktop \
    -exec rm -rf {} + 2>/dev/null || true
rm -rf /usr/share/locale/* 2>/dev/null || true
mkdir -p /usr/share/locale/en/LC_MESSAGES
cp -a /usr/share/locale/en_GB/LC_MESSAGES/* /usr/share/locale/en/LC_MESSAGES/ 2>/dev/null || true

# Caches that only slow the first boot down.
rm -rf /var/cache/fontconfig/* /var/cache/man/* 2>/dev/null || true
rm -rf /usr/share/doc-base/* 2>/dev/null || true

echo "[winacuxos] image diet applied: $(du -sh / 2>/dev/null | cut -f1)" | tee -a "$LOG"

echo "[winacuxos] boot trim complete" | tee -a "$LOG"