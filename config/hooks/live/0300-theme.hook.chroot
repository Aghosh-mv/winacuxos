#!/bin/sh
# Appearance policy for WinacuxOS.
#
# An earlier version of this hook tried to derive a custom GNOME Shell theme
# ("Winacux") from the shell stylesheet. That turned out to be impossible on
# Debian 13: gnome-shell ships no gnome-shell.css on disk and its resources are
# not extractable with gresource, so there is nothing to derive from - and
# pointing the user-theme extension at a non-existent theme file breaks the
# whole shell at login.
#
# So WinacuxOS does theming the way that actually works:
#   * the shell extension's own stylesheet (widgets, palette, composer, dock)
#   * GNOME's own settings (accent colour, light/dark, font, icon theme)
#   * blur-my-shell for the glassy panels
#   * Theme Studio, which rewrites ~/.config/winacux/theme.css live
set -e

LOG=/var/log/winacuxos-build.log
echo "[winacuxos] appearance policy: extension CSS + GNOME settings" | tee -a "$LOG"

# Verify the extension stylesheet really is in place - that, not a shell theme
# file, is what carries the WinacuxOS look.
EXT=/usr/share/gnome-shell/extensions/winacux@winacuxos.org
if [ ! -s "$EXT/stylesheet.css" ]; then
    echo "[winacuxos] FATAL: extension stylesheet missing - the desktop would be unstyled" | tee -a "$LOG"
    exit 1
fi

echo "[winacuxos] $(wc -l < "$EXT/stylesheet.css") lines of shell styling present" | tee -a "$LOG"

# The stock shell theme must stay in place: user-theme must never be pointed at
# a file we do not ship.
mkdir -p /usr/share/themes
echo "[winacuxos] leaving the stock shell theme in place (on purpose)" | tee -a "$LOG"