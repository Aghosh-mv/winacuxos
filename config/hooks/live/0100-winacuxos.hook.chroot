#!/bin/sh
# WinacuxOS chroot hook (runs as root inside the image being built).
#
#  - validates every dconf key we ship actually exists in the installed schemas
#  - builds the WinacuxOS plymouth (boot splash) theme
#  - generates the locale and compiles the dconf system database
set -e

LOG=/var/log/winacuxos-build.log
: > "$LOG"

echo "[winacuxos] validating shipped dconf keys" | tee -a "$LOG"

DB=/etc/dconf/db/local.d/00-winacuxos
if [ -f "$DB" ]; then
    SCHEMAS=/usr/share/glib-2.0/schemas
    # For each "key='value'" line, confirm a schema defines that key name.
    sed -n "s/^[[:space:]]*\([a-zA-Z0-9_-]*\)='.*/\1/p" "$DB" | sort -u | while read -r key; do
        if ! grep -rqs "<key name=\"$key\"" "$SCHEMAS"; then
            echo "[winacuxos] WARNING: no installed schema defines key '$key'" | tee -a "$LOG"
        fi
    done
    echo "[winacuxos] dconf key check complete" | tee -a "$LOG"
fi

# ---------------------------------------------------------------- plymouth
if [ -d /usr/share/plymouth/themes/spinner ]; then
    echo "[winacuxos] installing plymouth boot theme" | tee -a "$LOG"
    THEME=/usr/share/plymouth/themes/winacuxos
    rm -rf "$THEME"
    cp -a /usr/share/plymouth/themes/spinner "$THEME"
    mv "$THEME/spinner.plymouth" "$THEME/winacuxos.plymouth"
    sed -i "s|/themes/spinner|/themes/winacuxos|g" "$THEME/winacuxos.plymouth"
    sed -i "s|^Name=.*|Name=WinacuxOS|" "$THEME/winacuxos.plymouth"
    sed -i "s|^Description=.*|Description=WinacuxOS boot splash|" "$THEME/winacuxos.plymouth"
    if [ -f /usr/share/winacuxos/logo-256.png ]; then
        cp /usr/share/winacuxos/logo-256.png "$THEME/spinner-logo.png"
    fi
    mkdir -p /usr/share/plymouth/themes/default
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        # -R also refreshes the initramfs.
        plymouth-set-default-theme -R winacuxos || \
            echo "[winacuxos] WARNING: plymouth-set-default-theme failed" | tee -a "$LOG"
    else
        update-alternatives --install /usr/share/plymouth/themes/default/theme \
            default-theme "$THEME/winacuxos.plymouth" 100
        update-alternatives --set default-theme "$THEME/winacuxos.plymouth"
        update-initramfs -u -k all
    fi
    echo "[winacuxos] plymouth theme installed" | tee -a "$LOG"
fi

# ---------------------------------------------------------------- locale
echo "[winacuxos] generating en_US.UTF-8" | tee -a "$LOG"
if ! grep -q '^en_US.UTF-8 UTF-8' /etc/locale.gen; then
    echo 'en_US.UTF-8 UTF-8' >> /etc/locale.gen
fi
locale-gen >/dev/null

# ---------------------------------------------------------------- Winacux shell extension
EXT_DIR=/usr/share/gnome-shell/extensions/winacux@winacuxos.org
if [ -d "$EXT_DIR" ]; then
    echo "[winacuxos] compiling WinacuxOS extension schemas" | tee -a "$LOG"
    glib-compile-schemas "$EXT_DIR/schemas"

    # Also install the schema system-wide so other apps (the Mouse settings
    # window) can read and write the cursor trail settings.
    cp "$EXT_DIR/schemas/org.gnome.shell.extensions.winacux.gschema.xml" \
       /usr/share/glib-2.0/schemas/
    glib-compile-schemas /usr/share/glib-2.0/schemas

    chmod +x /usr/local/bin/wcx /usr/local/bin/wcx-cursors /usr/local/bin/winacux-mouse
    chmod +x /etc/dpkg/dpkg.d/99-winacux-snapshot

    # Fail loudly if the shell could never load the extension.
    if [ ! -f "$EXT_DIR/extension.js" ] || [ ! -f "$EXT_DIR/stylesheet.css" ]; then
        echo "[winacuxos] FATAL: WinacuxOS extension is incomplete" | tee -a "$LOG"
        exit 1
    fi
fi

# ------------------------------------------------- first boot experience
# GNOME's own welcome balloon ("Welcome to <distro>") is not WinacuxOS. Mask it
# and let the Winacux welcome take its place.
mkdir -p /etc/dconf/db/local.d
cat > /etc/dconf/db/local.d/01-winacux-firstboot <<'EOF'

[org/gnome/desktop/initial-setup]
thirdparty-notice=true
EOF

# Masking the unit was not enough: the balloon is started by the greeter
# session. Removing the package is the only reliable way, and WinacuxOS has its
# own first-boot experience to ship instead.
if dpkg -s gnome-initial-setup >/dev/null 2>&1; then
    apt-get purge -y --auto-remove gnome-initial-setup >/dev/null 2>&1 || true
    echo "[winacuxos] removed gnome-initial-setup (its own welcome replaces it)" | tee -a "$LOG"
fi

# A serial console makes the image debuggable and scriptable from another
# machine - that is how the boot tests drive it.
systemctl enable serial-getty@ttyS0.service >/dev/null 2>&1 || true

# ---------------------------------------------------------------- services
echo "[winacuxos] enabling WinacuxOS services" | tee -a "$LOG"
# Only enable the AI service when llama.cpp actually made it into the image;
# otherwise a slim build without the AI stage starts a unit that cannot work.
UNITS="winacux-recovery.service winacux-boot-attempt.service winacux-boot-success.service"
[ -x /usr/local/bin/llama-server ] && UNITS="winacux-ai.service $UNITS"

for unit in $UNITS; do
    if [ -f "/etc/systemd/system/$unit" ]; then
        systemctl enable "$unit" >/dev/null 2>&1 || \
            echo "[winacuxos] note: could not enable $unit" | tee -a "$LOG"
    fi
done

# ---------------------------------------------------------------- dconf
echo "[winacuxos] compiling dconf system database" | tee -a "$LOG"

# The session only reads /etc/dconf/db/local.d through /etc/dconf/profile/user.
# If that profile is missing, every default we ship is silently ignored - which
# is exactly what happened in an earlier build.
if [ ! -f /etc/dconf/profile/user ]; then
    echo "[winacuxos] FATAL: /etc/dconf/profile/user is missing" | tee -a "$LOG"
    exit 1
fi

dconf update

# Prove the system database is really readable, not just present.
if dconf dump /org/gnome/shell/extensions/dash-to-dock/ 2>/dev/null | grep -q dock-position; then
    echo "[winacuxos] system defaults are live (dconf reads them back)" | tee -a "$LOG"
else
    echo "[winacuxos] FATAL: dconf does not return our defaults - sessions would ignore them" | tee -a "$LOG"
    exit 1
fi

echo "[winacuxos] chroot hook finished" | tee -a "$LOG"