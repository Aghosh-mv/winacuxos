#!/bin/sh
# WinacuxOS AI backend: builds llama.cpp inside the image and fetches a small
# quantised model, so the assistant works fully offline on first boot.
#
# Set WINACUX_AI=0 to skip this stage (much faster build, no AI).
set -e

LOG=/var/log/winacuxos-build.log
# live-build does not pass the outer environment into chroot hooks, so the
# opt-out travels as a marker file instead of an env var.
if [ -f /etc/winacuxos-skip-ai ]; then
    echo "[winacuxos] skipping the AI stage (marker present)" | tee -a "$LOG"
    exit 0
fi

LLAMA_REPO="https://github.com/ggml-org/llama.cpp"
LLAMA_TAG="b4586"
MODEL_DIR=/opt/winacux/ai/models
MODEL_FILE="$MODEL_DIR/winacux-coder-q4_k_m.gguf"
MODEL_URL="https://huggingface.co/Qwen/Qwen2.5-Coder-0.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-0.5b-instruct-q4_k_m.gguf"

if ! command -v cmake >/dev/null || ! command -v git >/dev/null; then
    echo "[winacuxos] AI stage needs cmake + git (dev.list)" | tee -a "$LOG"
    exit 1
fi

echo "[winacuxos] building llama.cpp ($LLAMA_TAG)" | tee -a "$LOG"
rm -rf /tmp/llama.cpp
git clone --depth 1 --branch "$LLAMA_TAG" "$LLAMA_REPO" /tmp/llama.cpp >/dev/null 2>&1
cd /tmp/llama.cpp
# GGML_NATIVE=OFF matters: the image must not be tuned for the build host.
cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_NATIVE=OFF \
    -DLLAMA_CURL=OFF \
    -DGGML_OPENMP=OFF >/dev/null
cmake --build build -j "$(nproc)" --target llama-server llama-cli >/dev/null
install -m 0755 build/bin/llama-server /usr/local/bin/llama-server
install -m 0755 build/bin/llama-cli   /usr/local/bin/llama-cli
/usr/local/bin/llama-server --version 2>&1 | head -1 | tee -a "$LOG"
echo "[winacuxos] llama.cpp installed" | tee -a "$LOG"

echo "[winacuxos] fetching the local model" | tee -a "$LOG"
mkdir -p "$MODEL_DIR"
if [ -s "$MODEL_FILE" ]; then
    echo "[winacuxos] model already present" | tee -a "$LOG"
else
    # Downloads ~400MB; a failure here must not kill the whole image build.
    if curl -fL --retry 3 --connect-timeout 20 -o "$MODEL_FILE.part" "$MODEL_URL"; then
        mv "$MODEL_FILE.part" "$MODEL_FILE"
        ls -lh "$MODEL_FILE" | tee -a "$LOG"
    else
        echo "[winacuxos] WARNING: model download failed - run 'wcx-ai-fetch' later" | tee -a "$LOG"
        rm -f "$MODEL_FILE.part"
    fi
fi

cd /
rm -rf /tmp/llama.cpp
echo "[winacuxos] AI stage complete" | tee -a "$LOG"